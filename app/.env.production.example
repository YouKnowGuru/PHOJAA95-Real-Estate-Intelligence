# ============================================================
# PHOJAA95 Real Estate System — Production Environment
# ============================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to git.
# ============================================================

# -----------------------------------------------------------
# REQUIRED: Core Application
# -----------------------------------------------------------

# MySQL database connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=

# Strong random secret for HMAC signing, session tokens, etc.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Public API URL (used by frontend)
VITE_API_URL=https://yourdomain.com/api

# WebSocket URL — MUST use wss:// in production (encrypted)
VITE_WS_URL=wss://yourdomain.com/ws

# -----------------------------------------------------------
# REQUIRED: OAuth Authentication (Google)
# -----------------------------------------------------------

# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#  
# Typically: https://yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# -----------------------------------------------------------
# REQUIRED: OAuth Authentication (Microsoft)
# -----------------------------------------------------------

# Get from Azure Portal → App Registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft OAuth redirect URI (must match exactly in Azure)
# Typically: https://yourdomain.com/api/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/auth/microsoft/callback

# -----------------------------------------------------------
# REQUIRED: Cloudinary (Image/File Uploads)
# -----------------------------------------------------------

# Get from Cloudinary Dashboard → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------
# OPTIONAL: File Storage
# -----------------------------------------------------------

# Directory for uploaded files
# On Vercel (serverless), use /tmp/uploads (ephemeral)
# On VPS/dedicated server, use a persistent path like /var/www/uploads
UPLOAD_DIR=/tmp/uploads

# -----------------------------------------------------------
# OPTIONAL: Security / Infrastructure
# -----------------------------------------------------------

# Number of trusted proxies between app and internet
# Set to 1 if using Vercel, Cloudflare, or a single reverse proxy
# Increase if behind multiple proxies (e.g. CDN + load balancer)
TRUST_PROXY_COUNT=1

# -----------------------------------------------------------
# OPTIONAL: Logging
# -----------------------------------------------------------

# Log level: trace, debug, info, warn, error, fatal
# Use "info" or "warn" in production
LOG_LEVEL=info

# -----------------------------------------------------------
# NOTES
# -----------------------------------------------------------
# - NODE_ENV is automatically set to "production" by Vercel
# - Do NOT set PORT manually — Vercel handles this
# - Do NOT commit this file or any .env file to git
# - Rotate APP_SECRET if you suspect it has been leaked
# - Ensure all OAuth redirect URIs match exactly in provider consoles
# ============================================================
